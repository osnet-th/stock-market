# 배포 훅 리스너 systemd 유닛 (템플릿).
#
# 이 파일은 그대로 설치하지 않는다. 저장소가 public이므로 서버 사용자명과 홈 경로를
# 넣지 않고 플레이스홀더로 둔다. 배치할 때 아래 두 값을 치환한다.
#
#   __DEPLOY_USER__  배포를 실행할 서버 사용자. docker 그룹에 속해 있어야 한다.
#   __DEPLOY_HOME__  그 사용자의 홈 절대경로.
#
# 치환·설치 명령은 서버 반영 절차에서 제시한다.
#
# 리스너를 docker compose 밖(이 유닛)에 두는 이유: 배포가 `docker compose up -d --build`로
# 컨테이너를 재생성하므로, compose 안에 있으면 리스너가 자기 배포에 의해 재생성되며 끊긴다.

[Unit]
Description=Deploy hook listener
Documentation=https://github.com/osnet-th/stock-market
# 바인딩에 네트워크가 필요하고, 배포가 docker를 쓰므로 기동 순서를 맞춘다.
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__DEPLOY_HOME__
# 토큰은 이 파일에서만 주입한다(권한 0600). 파일이 없으면 기동하지 않는다.
EnvironmentFile=__DEPLOY_HOME__/.deploy-hook.env
# -u: 버퍼링을 끄고 로그가 곧바로 journal에 남게 한다.
ExecStart=/usr/bin/python3 -u __DEPLOY_HOME__/deploy-hook-listener.py
Restart=always
RestartSec=3

# 진행 중인 배포를 끊지 않기 위한 핵심 설정이다.
# 기본값 control-group은 유닛 재시작·중지 시 cgroup의 모든 프로세스를 죽이므로,
# 리스너를 restart 하면 실행 중인 배포까지 함께 죽는다. process로 두어
# 메인 프로세스만 종료하고 분리 실행된 배포는 그대로 완주하게 한다.
KillMode=process

StandardOutput=journal
StandardError=journal
SyslogIdentifier=deploy-hook

# 배포가 docker 소켓·git·gradle을 쓰므로 강한 샌드박싱은 배포를 깨뜨린다.
# 권한 상승만 막고 나머지는 기본값을 유지한다.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
